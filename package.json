{
  "name": "wechat-sync",
  "version": "0.0.7",
  "description": "微信公众号文章同步助手，支持多平台内容同步",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/@wechatsync/*"
  ],
  "author": "fun",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/wechatsync/Wechatsync.git"
  },
  "keywords": [
    "wechat",
    "weixin",
    "sync",
    "article",
    "publish",
    "chrome-extension",
    "vite",
    "vue"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist packages/*/.vite"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "cross-env": "^7.0.3",
    "jsdom": "^24.0.0",
    "jsdom-global": "^3.0.2",
    "sass": "^1.80.0",
    "vite": "^7.0.0",
    "vite-plugin-static-copy": "^1.0.0",
    "vite-plugin-zip": "^1.0.0"
  }
}
